# Fontes que dependem de navegador (Playwright + Chromium).
# Instale com: pip install playwright && playwright install chromium
#
# DESLIGADAS POR PADRAO. Cada busca sobe um Chromium (~250 MB), e a VM de
# producao tem 1 GB no total: com as tres ligadas o servidor parou de
# responder, inclusive no /health. Ligue (=1) apenas onde houver memoria
# sobrando -- em desenvolvimento, por exemplo.
#
# Com elas desligadas a busca segue funcionando por Estante Virtual e
# MangaDex, que respondem por HTTP em segundos.

BING_SHOPPING_ENABLED=0
ENJOEI_ENABLED=0
OLX_ENABLED=0

# Google Shopping - responde com pagina de verificacao anti-robo (CAPTCHA),
# entao hoje so reporta falha mesmo quando ligada.
GOOGLE_SHOPPING_ENABLED=0

# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por
# virgula. Sem a origem do front nesta lista, o navegador bloqueia a resposta.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Tempo maximo (em segundos) de uma busca antes de responder 504.
SEARCH_TIMEOUT_SECONDS=45

# Nivel de log do servidor: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
